<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window only shows before the first frame (and behind the
         system splash), so it matches the app background. Bars are set by enableEdgeToEdge. -->
    <style name="Theme.Dibe" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <!-- Dark.Background in ui/theme/Color.kt; used by values-night. -->
    <color name="dibe_night_background">#181818</color>
</resources>
