{
	"$schema": "./gen/schemas/desktop-schema.json",
	"productName": "DIBE",
	"mainBinaryName": "dibe",
	"version": "1.4.0",
	"identifier": "io.github.akucbruhu0-cyber.dibe",
	"app": {
		"macOSPrivateApi": true,
		"windows": [],
		"withGlobalTauri": true,
		"security": {
			"assetProtocol": {
				"scope": {
					"allow": ["**"],
					"deny": [],
					"requireLiteralLeadingDot": false
				},
				"enable": true
			},
			"csp": null
		}
	},
	"build": {
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420"
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "deb", "rpm", "dmg", "app"],
		"createUpdaterArtifacts": false,
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"externalBin": ["binaries/vibe-server"],
		"copyright": "DIBE is a fork of Vibe by thewh1teagle (MIT License)",
		"shortDescription": "Private, local transcription with live text while you record"
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFNTJENkIxNTM4NTQxODgKUldTSVFZVlRzZFpTL21VWTBzak1IMTA1ZjdNVHA0MXQ3Y20wa2F2U24zVGl6WUUvTGVoQi8wN1kK",
			"endpoints": []
		},
		"deep-link": {
			"mobile": [],
			"desktop": {
				"schemes": ["dibe"]
			}
		}
	}
}
